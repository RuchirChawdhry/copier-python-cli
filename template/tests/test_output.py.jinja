import json
from datetime import date
from pathlib import Path

import orjson
import pytest

from {{ package_name }}.output import Output, OutputOptions


def test_json_and_jsonl(capsys) -> None:
    records = [{"id": 1}, {"id": 2}]
    Output(OutputOptions(json=True)).emit(records)
    assert json.loads(capsys.readouterr().out) == records
    output = Output(OutputOptions(jsonl=True, verbose=True))
    assert list(output.track(records, total=2)) == records
    output.note("diagnostic")
    output.emit(records)
    captured = capsys.readouterr()
    assert [json.loads(line) for line in captured.out.splitlines()] == records
    assert captured.err.strip() == "diagnostic"


def test_quiet_retains_results(capsys) -> None:
    output = Output(OutputOptions(quiet=True))
    output.note("hidden")
    output.emit({"message": "hello"}, human="hello")
    captured = capsys.readouterr()
    assert captured.out == "hello\n"
    assert captured.err == ""


@pytest.mark.parametrize(
    "options",
    [OutputOptions(json=True, jsonl=True), OutputOptions(quiet=True, verbose=True)],
)
def test_conflicting_options(options: OutputOptions, capsys) -> None:
    with pytest.raises(SystemExit) as error, Output(options).guard():
        pytest.fail("Conflicting flags should prevent command execution")
    assert error.value.code == 1
    captured = capsys.readouterr()
    assert captured.out == ""
    assert "mutually exclusive" in captured.err


@pytest.mark.parametrize("options", [OutputOptions(json=True), OutputOptions(jsonl=True)])
def test_machine_output_ignores_forced_terminal(options, monkeypatch, capsys) -> None:
    monkeypatch.setenv("FORCE_COLOR", "1")
    output = Output(options)
    assert output.stdout.color_system is None
    assert output.stderr.color_system is None
    assert output.progress().disable
    output.emit({"message": "[red]literal[/red]"}, human="[red]styled[/red]")
    captured = capsys.readouterr()
    assert json.loads(captured.out) == {"message": "[red]literal[/red]"}
    assert "\x1b" not in captured.out
    assert captured.err == ""


@pytest.mark.parametrize("jsonl", [False, True])
def test_orjson_utf8_serialization(jsonl: bool, capsysbinary) -> None:
    records = [{"name": "नमस्ते", "date": date(2026, 1, 1), "path": Path("example")}]
    output = Output(OutputOptions(json=not jsonl, jsonl=jsonl))
    output.emit(records)
    captured = capsysbinary.readouterr()
    expected = records[0] if jsonl else records
    assert captured.out == orjson.dumps(
        expected, default=str, option=orjson.OPT_APPEND_NEWLINE | orjson.OPT_NON_STR_KEYS
    )
    assert "नमस्ते".encode() in captured.out
    assert captured.err == b""


def test_empty_jsonl(capsysbinary) -> None:
    Output(OutputOptions(jsonl=True)).emit([])
    assert capsysbinary.readouterr().out == b""


def test_json_encoding_error(capsys) -> None:
    output = Output(OutputOptions(json=True))
    with pytest.raises(SystemExit) as error, output.guard():
        output.emit({"too_large": 2**80})
    assert error.value.code == 1
    captured = capsys.readouterr()
    assert captured.out == ""
    assert "Error:" in captured.err
