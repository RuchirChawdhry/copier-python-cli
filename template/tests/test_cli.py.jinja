def test_configuration_dispatches_only_selected_action(tmp_path: Path, monkeypatch) -> None:
    path = tmp_path / "config.yml"
    monkeypatch.setattr(settings, "default_config_path", lambda: path)
    configuration(config_path=True)
    assert not path.exists()
    configuration(show_config=True)
    assert not path.exists()
    configuration(init_config=True)
    assert path.is_file()


@pytest.mark.parametrize(
    "error",
    [
        ApplicationError("expected failure"),
        FileNotFoundError("missing"),
        sqlite3.OperationalError("bad database"),
    ],
)
def test_main_handles_application_errors(error: Exception, monkeypatch, capsys) -> None:
    def fail(*args, **kwargs):
        raise error

    monkeypatch.setattr(cli, "app", fail)
    assert main([]) == 1
    captured = capsys.readouterr()
    assert captured.out == ""
    assert captured.err == f"Error: {error}\n"


@pytest.mark.parametrize("error", [ValueError("bug"), TypeError("bug"), RuntimeError("bug")])
def test_main_does_not_swallow_programming_errors(error: Exception, monkeypatch) -> None:
    def fail(*args, **kwargs):
        raise error

    monkeypatch.setattr(cli, "app", fail)
    with pytest.raises(type(error), match="bug"):
        main([])


def test_main_preserves_command_exit_code(monkeypatch) -> None:
    monkeypatch.setattr(cli, "app", lambda *args, **kwargs: 7)
    assert main([]) == 7


