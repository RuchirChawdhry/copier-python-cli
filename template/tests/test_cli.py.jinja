import subprocess
import sys

from {{ package_name }}.cli import hello


def test_hello(capsys) -> None:
    hello("agent")
    assert "Hello, agent!" in capsys.readouterr().out


def test_module_help() -> None:
    result = subprocess.run(
        [sys.executable, "-m", "{{ package_name }}", "--help"],
        check=True,
        capture_output=True,
        text=True,
    )
    assert "hello" in result.stdout
    assert "show-config" in result.stdout
