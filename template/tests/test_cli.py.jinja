def test_hello(capsys, tmp_path: Path) -> None:
    path = tmp_path / "config.yml"
    path.write_text("logging:\n  file_enabled: false\n", encoding="utf-8")
    try:
        hello("agent", config=path)
        assert "Hello, agent!" in capsys.readouterr().out
    finally:
        logger.remove()


def run_cli(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [sys.executable, "-m", "{{ package_name }}", *args],
        check=True,
        capture_output=True,
        text=True,
    )


def test_module_help() -> None:
    result = run_cli("--help")
    assert "hello" in result.stdout
    assert "--show-config" in result.stdout
    assert "set-config" in result.stdout
    assert "--init-config" in result.stdout
    assert "--config-path" in result.stdout
    assert "db-list" in result.stdout
    assert "db-path" in result.stdout
    assert "db-set" not in result.stdout
    assert "db-get" not in result.stdout
    assert "--no-color" not in result.stdout
    assert "--no-color" not in run_cli("hello", "--help").stdout


def test_config_commands(tmp_path: Path) -> None:
    path = str(tmp_path / "settings.yml")
    run_cli("--init-config", "--path", path)
    run_cli("set-config", "logging.verbosity", "2", "--path", path)
    run_cli("set-config", "logging.file_enabled", "false", "--path", path)
    result = run_cli("--show-config", "--path", path)
    assert "verbosity: 2" in result.stdout
    assert "file_enabled: false" in result.stdout
    result = run_cli("hello", "--config", path, "--verbosity", "1")
    assert "Hello, world!" in result.stdout
    assert "Greeting requested" in result.stderr


def test_machine_output(tmp_path: Path, monkeypatch) -> None:
    monkeypatch.setenv("FORCE_COLOR", "1")
    config = tmp_path / "config.yml"
    config.write_text("logging:\n  file_enabled: false\n", encoding="utf-8")
    result = run_cli("hello", "--config", str(config), "--json", "--verbose")
    assert json.loads(result.stdout) == {"message": "Hello, world!"}
    assert "Greeting requested" in result.stderr
    assert "\x1b" not in result.stdout
    assert "\x1b" not in result.stderr
    result = run_cli("hello", "--config", str(config), "--jsonl", "--quiet")
    assert json.loads(result.stdout) == {"message": "Hello, world!"}
    assert "\x1b" not in result.stdout
    assert result.stderr == ""


def test_db_commands(tmp_path: Path) -> None:
    path = tmp_path / "db.sqlite3"
    set_record("b", "two", path)
    set_record("a", "one", path)
    result = run_cli("db-list", "--path", str(path), "--jsonl")
    assert [json.loads(line)["key"] for line in result.stdout.splitlines()] == ["a", "b"]
    assert json.loads(run_cli("db-list", "--path", str(path), "--json").stdout)[1]["value"] == "two"


def test_conflict_prevents_write(tmp_path: Path) -> None:
    path = tmp_path / "db.sqlite3"
    result = subprocess.run(
        [
            sys.executable,
            "-m",
            "{{ package_name }}",
            "db-list",
            "--path",
            str(path),
            "--json",
            "--jsonl",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    assert result.returncode != 0
    assert result.stdout == ""
    assert not path.exists()


def test_root_config_flags(tmp_path: Path) -> None:
    path = tmp_path / "custom.yml"
    result = run_cli("--init-config", "--path", str(path), "--json")
    assert json.loads(result.stdout) == {"path": str(path)}
    result = run_cli("--show-config", "--path", str(path), "--jsonl")
    assert json.loads(result.stdout)["logging"]["verbosity"] == 0
    result = run_cli("--config-path", "--json")
    assert Path(json.loads(result.stdout)["path"]).name == "config.yml"
    assert not run_cli().stderr


def test_root_conflict_does_not_write(tmp_path: Path) -> None:
    path = tmp_path / "custom.yml"
    result = subprocess.run(
        [
            sys.executable,
            "-m",
            "{{ package_name }}",
            "--init-config",
            "--show-config",
            "--path",
            str(path),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    assert result.returncode != 0
    assert result.stdout == ""
    assert "Error" in result.stderr
    assert not path.exists()


@pytest.mark.parametrize(
    "args",
    [
        ["db-list", "--json", "--jsonl"],
        ["db-list", "--quiet", "--verbose"],
        ["--show-config", "--init-config"],
        ["--config-path", "--show-config"],
        ["--config-path", "--path", "custom.yml"],
        ["hello", "--verbosity", "4"],
        ["hello", "--verbosity", "-1"],
        ["--show-config", "--json", "--jsonl"],
        ["--show-config", "--quiet", "--verbose"],
    ],
)
def test_native_validation(args: list[str], monkeypatch, tmp_path: Path) -> None:
    monkeypatch.setattr(settings, "default_config_path", lambda: tmp_path / "config.yml")
    with pytest.raises(ValidationError):
        app.parse_args(args, exit_on_error=False, print_error=False)


def test_yaml_command_defaults_and_overrides(tmp_path: Path) -> None:
    path = tmp_path / "settings.yml"
    path.write_text(
        "logging:\n  file_enabled: false\ncli:\n  hello:\n    name: Ada\n    verbosity: 1\n",
        encoding="utf-8",
    )
    result = run_cli("hello", "--config", str(path), "--json")
    assert json.loads(result.stdout) == {"message": "Hello, Ada!"}
    assert "Greeting requested" in result.stderr
    result = run_cli(
        "hello", "--config", str(path), "--name", "Grace", "--verbosity", "0", "--json"
    )
    assert json.loads(result.stdout) == {"message": "Hello, Grace!"}
    assert result.stderr == ""


def test_invalid_yaml_cli_default_is_rejected(tmp_path: Path) -> None:
    path = tmp_path / "settings.yml"
    path.write_text("cli:\n  hello:\n    verbosity: 9\n", encoding="utf-8")
    with pytest.raises(ValidationError):
        app.parse_args(["hello", "--config", str(path)], exit_on_error=False, print_error=False)
    # Config-management commands do not parse command defaults and can repair them.
    run_cli("set-config", "cli.hello.verbosity", "1", "--path", str(path))
    assert (
        json.loads(run_cli("--show-config", "--path", str(path), "--json").stdout)["cli"]["hello"][
            "verbosity"
        ]
        == 1
    )


def test_platform_yaml_defaults(monkeypatch, tmp_path: Path) -> None:
    path = tmp_path / "config.yml"
    path.write_text("cli:\n  hello:\n    name: Ada\n", encoding="utf-8")
    monkeypatch.setattr(settings, "default_config_path", lambda: path)
    _, bound, _ = app.parse_args(["hello", "--json", "--verbose"], exit_on_error=False)
    assert bound.arguments["name"] == "Ada"
    assert bound.arguments["options"].json
    assert bound.arguments["options"].verbose
    _, bound, _ = app.parse_args(["hello", "--name", "Grace"], exit_on_error=False)
    assert bound.arguments["name"] == "Grace"


