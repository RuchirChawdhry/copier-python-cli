import pytest
from cyclopts import ValidationError
from loguru import logger
from ruamel.yaml import YAML
from ruamel.yaml.error import YAMLError

from {{ package_name }} import cli
from {{ package_name }} import config as settings
from {{ package_name }}.cli import app, configuration, hello, main
