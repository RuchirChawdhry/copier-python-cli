def test_yaml_error_preserves_parser_diagnostics(tmp_path: Path) -> None:
    path = tmp_path / "config.yml"
    path.write_text("logging: [invalid-value\n", encoding="utf-8")
    with pytest.raises(YAMLError) as error, path.open(encoding="utf-8") as stream:
        YAML(typ="safe").load(stream)
    result = subprocess.run(
        [sys.executable, "-m", "{{ package_name }}", "--show-config", "--path", str(path)],
        capture_output=True,
        text=True,
        check=False,
    )
    assert result.returncode == 1
    assert result.stdout == ""
    assert result.stderr == f"Error: {error.value}\n"


def test_doctor_returns_failure_status(monkeypatch, capsys) -> None:
    monkeypatch.setattr(
        cli, "run_checks", lambda: iter([{"name": "example", "ok": False, "detail": "failure"}])
    )
    assert main(["doctor", "--json"]) == 1
    assert json.loads(capsys.readouterr().out)[0]["ok"] is False
