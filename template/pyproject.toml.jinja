[build-system]
requires = ["uv_build>=0.13.6,<0.14"]
build-backend = "uv_build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.14"
license = "MIT"
authors = [{ name = "{{ author_name }}" }]
dependencies = [
    "cyclopts",
    "rich",
    "ruamel.yaml",
]

[project.scripts]
"{{ cli_command }}" = "{{ package_name }}.cli:app"

[dependency-groups]
dev = ["pytest", "ruff"]

[tool.uv.build-backend]
module-name = "{{ package_name }}"

[tool.ruff]
target-version = "py314"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra"
