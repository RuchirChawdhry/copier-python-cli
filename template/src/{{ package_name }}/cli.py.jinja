"""Cyclopts command definitions; keep logic in separate modules."""

from functools import partial
from io import StringIO
from pathlib import Path
from typing import Annotated

from cyclopts import App, ArgumentCollection, Group, Parameter, validators
from cyclopts.config import Yaml
from loguru import logger
from rich.console import Console
from rich.table import Table
from rich.text import Text
from ruamel.yaml import YAML

from . import database
from . import config as settings
from .doctor import CHECK_COUNT, run_checks
from .output import Output, OutputOptions

CONFIG_ACTIONS = Group("Configuration actions", validator=validators.MutuallyExclusive())
CONFIG_PATH_EXCLUSION = Group(
    "Configuration path restriction", show=False, validator=validators.MutuallyExclusive()
)
Verbosity = Annotated[int | None, Parameter(validator=validators.Number(gte=0, lte=3))]
ConfigFile = Annotated[Path | None, Parameter(validator=validators.Path(dir_okay=False))]

app = App(
    name="{{ cli_command }}",
    default_parameter=Parameter(negative=()),
    console=Console(force_terminal=False),
    error_console=Console(stderr=True, force_terminal=False),
)


def command_defaults(app: App, commands: tuple[str, ...], arguments: ArgumentCollection) -> None:
    """Select the settings file; let Cyclopts load, merge and validate its CLI defaults."""
    config_argument, _, _ = arguments.match("--config")
    tokens = config_argument.tokens
    path = Path(tokens[0].value) if tokens else settings.default_config_path()
    Yaml(path, root_keys=("cli",), encoding="utf-8")(app, commands, arguments)


@app.command(config=command_defaults)
def hello(
    name: str = "world",
    *,
    config: ConfigFile = None,
    verbosity: Verbosity = None,
    options: OutputOptions = OutputOptions(),
) -> None:
    """Print a friendly greeting; demonstrate logging and structured results."""
    output = Output(options)
    with output.guard():
        logging = settings.LoggingConfig.from_config(settings.read_settings(config))
        if output.options.verbose:
            verbosity = max(2, logging.verbosity if verbosity is None else verbosity)
        logging.configure(
            verbosity,
            quiet=output.options.quiet,
            no_color=output.machine,
        )
        logger.info("Greeting requested")
        message = f"Hello, {name}!"
        output.emit({"message": message}, human=message)


def _initialize_config(output: Output, path: ConfigFile) -> None:
    output.note("Initializing YAML configuration")
    result = str(settings.init_config(path))
    output.emit({"path": result}, human=result)


def _display_config_path(output: Output) -> None:
    result = str(settings.default_config_path())
    output.emit({"path": result}, human=result)


def _display_config(output: Output, path: ConfigFile) -> None:
    output.note("Reading YAML configuration")
    config = settings.read_settings(path)
    stream = StringIO()
    if not output.machine:
        YAML().dump(config, stream)
    output.emit(config, human=stream.getvalue().rstrip("\n"))


@app.default
def configuration(
    *,
    init_config: Annotated[bool, Parameter(group=CONFIG_ACTIONS)] = False,
    config_path: Annotated[bool, Parameter(group=(CONFIG_ACTIONS, CONFIG_PATH_EXCLUSION))] = False,
    show_config: Annotated[bool, Parameter(group=CONFIG_ACTIONS)] = False,
    path: Annotated[ConfigFile, Parameter(group=CONFIG_PATH_EXCLUSION)] = None,
    options: OutputOptions = OutputOptions(),
) -> None:
    """Manage the application configuration.

    Args:
        init_config: Create default YAML settings without overwriting an existing file.
        config_path: Print the default user configuration path.
        show_config: Display YAML settings, or defaults if no file exists.
        path: Override the file for --init-config or --show-config.
        options: Shared output flags.
    """
    output = Output(options)
    with output.guard():
        actions = {
            "init-config": (init_config, partial(_initialize_config, output, path)),
            "config-path": (config_path, partial(_display_config_path, output)),
            "show-config": (show_config, partial(_display_config, output, path)),
        }
        action = next((handler for selected, handler in actions.values() if selected), None)
        if action is not None:
            action()
            return
        if path is not None or options != OutputOptions():
            raise ValueError("Select a configuration flag or a subcommand")
        app.help_print([])

@app.command
def set_config(
    key: str, value: str, *, path: ConfigFile = None, options: OutputOptions = OutputOptions()
) -> None:
    """Set a dotted configuration key to a YAML value."""
    output = Output(options)
    with output.guard():
        output.note(f"Updating setting: {key}")
        result = str(settings.update_setting(key, value, path))
        output.emit({"path": result, "key": key}, human=result)


@app.command
def doctor(*, options: OutputOptions = OutputOptions()) -> None:
    """Diagnose Python, platform, configuration, paths and SQLite without writing."""
    output = Output(options)
    with output.guard():
        output.note("Checking runtime and local storage")
        checks = list(output.track(run_checks(), description="Checking", total=CHECK_COUNT))
        table = Table(title="Environment diagnostics")
        table.add_column("Check")
        table.add_column("Status")
        table.add_column("Detail")
        for check in checks:
            table.add_row(
                str(check["name"]),
                "[green]OK[/green]" if check["ok"] else "[red]FAIL[/red]",
                Text(str(check["detail"])),
            )
        output.emit(checks, human=table)
        if not all(check["ok"] for check in checks):
            raise SystemExit(1)


@app.command
def db_path(*, options: OutputOptions = OutputOptions()) -> None:
    """Print the default SQLite database path without initializing it."""
    output = Output(options)
    with output.guard():
        path = str(database.default_database_path())
        output.emit({"path": path}, human=path)


@app.command
def db_list(*, path: ConfigFile = None, options: OutputOptions = OutputOptions()) -> None:
    """List records in deterministic key order."""
    output = Output(options)
    with output.guard():
        output.note("Listing SQLite records")
        output.emit(database.list_records(path))
