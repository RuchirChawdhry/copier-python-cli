"""Cyclopts command definitions; put business logic in separate modules."""

import sys
from pathlib import Path

from cyclopts import App
from loguru import logger
from rich.console import Console
from ruamel.yaml import YAML

from . import config as settings

app = App(name="{{ cli_command }}")


@app.command
def hello(
    name: str = "world",
    *,
    config: Path | None = None,
    verbosity: int | None = None,
) -> None:
    """Print a friendly greeting.

    Args:
        name: Name to greet.
        config: Override the user configuration file.
        verbosity: Override console verbosity (0 to 3) for this invocation.
    """
    settings.LoggingConfig.from_config(settings.read_settings(config)).configure(verbosity)
    logger.info("Greeting requested")
    Console().print(f"Hello, {name}!")


@app.command
def config_path() -> None:
    """Print the default user configuration path."""
    print(settings.default_config_path())


@app.command
def init_config(path: Path | None = None) -> None:
    """Create a default YAML configuration without overwriting settings."""
    print(settings.init_config(path))


@app.command
def show_config(path: Path | None = None) -> None:
    """Print YAML settings; use defaults when no user config exists."""
    YAML().dump(settings.read_settings(path), sys.stdout)


@app.command
def set_config(key: str, value: str, *, path: Path | None = None) -> None:
    """Set a dotted configuration key to a YAML value."""
    print(settings.update_setting(key, value, path))
