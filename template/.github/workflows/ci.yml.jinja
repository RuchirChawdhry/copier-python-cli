# This file exists only in projects generated by Copier.
# The template repository stores it under template/ so GitHub never activates it there.
name: Python CLI CI

on:
  pull_request:

permissions:
  contents: read

jobs:
  quality:
    uses: RuchirChawdhry/ci-workflows/.github/workflows/python-cli.yml@main
    with:
      python-version: '3.14.7'
      cli-command: '{{ cli_command }}'

  distribution:
    uses: RuchirChawdhry/ci-workflows/.github/workflows/python-build.yml@main
    with:
      python-version: '3.14.7'
      cli-command: '{{ cli_command }}'
